page { height:100%; min-height:100%; overflow:hidden; background:#111722; color:#f5e9c9; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }
.screen { height:100vh; min-height:100vh; display:flex; flex-direction:column; padding:18rpx 28rpx 22rpx; box-sizing:border-box; overflow:hidden; background:radial-gradient(ellipse at 50% 42%,#263444 0,#111722 74%); }
.topbar { flex:none; display:flex; justify-content:space-between; align-items:center; padding:8rpx 4rpx 16rpx; }
.brand { display:block; font-size:40rpx; font-weight:800; letter-spacing:5rpx; color:#f1d48c; text-shadow:0 2rpx 16rpx #aa743a; }
.subtitle { display:block; margin-top:7rpx; font-size:20rpx; color:#96a5b4; letter-spacing:2rpx; }
.stats { display:flex; flex-direction:column; align-items:flex-end; gap:8rpx; color:#e9d9b7; font-size:23rpx; }
.progress,.xp-track { flex:none; height:8rpx; overflow:hidden; background:#26313b; border-radius:9rpx; }
.progress-fill { height:100%; background:linear-gradient(90deg,#658f8a,#dfbd71); }
.arena { position:relative; flex:1; min-height:0; margin-top:18rpx; overflow:hidden; border:2rpx solid rgba(198,174,118,.35); border-radius:30rpx; background:radial-gradient(circle at 50% 50%,rgba(55,75,82,.35),rgba(12,18,26,.78)),repeating-radial-gradient(circle at 50% 50%,transparent 0 75rpx,rgba(126,149,144,.06) 77rpx 79rpx); box-shadow:inset 0 0 60rpx rgba(0,0,0,.6); }
.arena:after { content:""; position:absolute; inset:12%; border:1rpx solid rgba(208,188,140,.09); border-radius:50%; pointer-events:none; }
.arena-title { position:absolute; top:24rpx; width:100%; text-align:center; z-index:1; font-size:27rpx; color:#e7d2a3; letter-spacing:3rpx; }
.hint { position:absolute; bottom:25rpx; left:0; right:0; text-align:center; color:#7d8b99; font-size:20rpx; z-index:1; }
.player,.enemy,.effect { position:absolute; transform:translate(-50%,-50%); z-index:2; }
.player { width:66rpx; height:66rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#ffe7a5; font-size:48rpx; background:radial-gradient(circle,#d5b96a 0,#74633c 45%,rgba(26,34,42,.3) 72%); box-shadow:0 0 25rpx rgba(244,205,116,.65); transition:left .14s linear,top .14s linear; }
.enemy { min-width:55rpx; min-height:55rpx; text-align:center; font-size:44rpx; filter:drop-shadow(0 4rpx 5rpx #000); transition:left .14s linear,top .14s linear; }
.enemy.boss { font-size:78rpx; min-width:90rpx; min-height:90rpx; animation:pulse 1.4s ease-in-out infinite alternate; }
.enemy-hp { width:54rpx; height:7rpx; margin:0 auto; background:#442e32; border-radius:8rpx; overflow:hidden; }
.boss .enemy-hp { width:100rpx; height:9rpx; }
.enemy-hp view { height:100%; background:#d75d57; }
.effect { z-index:3; font-size:35rpx; animation:hit .22s ease-out forwards; pointer-events:none; }
.weapon-badge { position:absolute; z-index:1; left:18rpx; top:20rpx; padding:9rpx 14rpx; border:1rpx solid #677167; border-radius:24rpx; color:#c7cfbc; font-size:20rpx; background:rgba(16,24,28,.7); }
.toast { position:absolute; top:85rpx; left:8%; width:84%; z-index:5; padding:14rpx 10rpx; text-align:center; border-radius:12rpx; background:rgba(7,12,18,.9); color:#efcf86; font-size:22rpx; }
.overlay { position:absolute; inset:0; z-index:8; display:flex; align-items:center; justify-content:center; padding:26rpx; box-sizing:border-box; background:rgba(5,9,14,.82); }
.choice-panel { width:100%; padding:28rpx 24rpx; border:1rpx solid rgba(228,195,125,.5); border-radius:22rpx; background:linear-gradient(145deg,#27303a,#151c25); box-shadow:0 12rpx 50rpx #000; }
.choice-title { display:block; margin:0 0 22rpx; text-align:center; font-size:32rpx; color:#f0d18c; font-weight:700; }
.choice { display:flex; align-items:center; gap:18rpx; margin-top:14rpx; padding:18rpx 16rpx; border-radius:14rpx; background:rgba(217,202,166,.08); border:1rpx solid rgba(217,202,166,.17); }
.choice-icon { font-size:43rpx; }
.choice-name,.choice-desc { display:block; }
.choice-name { font-size:26rpx; color:#f1e3c3; }
.choice-desc { margin-top:6rpx; font-size:21rpx; color:#aab5bd; }
.arrow { margin-left:auto; color:#d5ba7d; font-size:42rpx; }
.bottom { flex:none; padding:18rpx 4rpx 0; background:#111722; }
.xp-label { display:flex; justify-content:space-between; margin-bottom:10rpx; color:#b8c2c5; font-size:21rpx; }
.xp-fill { height:100%; background:linear-gradient(90deg,#56a69c,#e2c36f); }
.bottom-row { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; color:#aeb8bb; font-size:21rpx; }
.dash,.restart { margin:0; padding:0 22rpx; border:1rpx solid #a18b5f; border-radius:24rpx; background:#363a34; color:#f0d18c; font-size:22rpx; line-height:1.8; }
.ending { text-align:center; }
.ending-copy { display:block; margin:26rpx 12rpx; color:#c0c7c4; font-size:25rpx; line-height:1.8; }
.restart { margin:14rpx auto 0; padding:8rpx 36rpx; }
@keyframes pulse { from{filter:drop-shadow(0 0 2rpx #dba85b)} to{filter:drop-shadow(0 0 12rpx #e37d51)} }
@keyframes hit { from{opacity:1;transform:translate(-50%,-50%) scale(.5)} to{opacity:0;transform:translate(-50%,-50%) scale(1.5)} }
.home-screen { position:relative; height:100vh; min-height:100vh; box-sizing:border-box; display:flex; flex-direction:column; justify-content:space-between; overflow:hidden; padding:54rpx 48rpx 62rpx; color:#f3e6c8; background:#17252c; }
.home-background { position:absolute; z-index:0; left:0; top:0; width:100%; height:100%; }
.home-scrim { position:absolute; z-index:0; inset:0; background:linear-gradient(180deg,rgba(8,15,20,.44),rgba(8,15,20,.08) 34%,rgba(8,15,20,.28) 66%,rgba(8,15,20,.78)); }
.home-sky:before { content:""; position:absolute; inset:0; opacity:.16; background:repeating-linear-gradient(112deg,transparent 0 31rpx,rgba(248,238,208,.18) 32rpx,transparent 34rpx 74rpx); mix-blend-mode:screen; }
.home-sun { display:none; position:absolute; left:50%; top:28%; width:300rpx; height:300rpx; border-radius:50%; transform:translate(-50%,-50%); background:radial-gradient(circle at 48% 44%,#f3e5bf 0,#dfc994 45%,rgba(213,190,138,.5) 66%,transparent 72%); opacity:.72; filter:blur(2rpx); }
.home-mountain { display:none; position:absolute; left:-15%; width:130%; bottom:19%; height:44%; opacity:.75; background:linear-gradient(150deg,transparent 0 22%,rgba(37,51,51,.55) 22.4% 23%,transparent 23.5% 28%,rgba(34,48,49,.67) 28.5% 29%,transparent 29.5%),linear-gradient(32deg,transparent 0 31%,rgba(44,57,55,.62) 31.5% 32%,transparent 32.5% 38%,rgba(37,50,49,.72) 38.5% 39%,transparent 39.5%); clip-path:polygon(0 74%,12% 42%,22% 65%,35% 17%,46% 62%,59% 7%,73% 59%,85% 26%,100% 70%,100% 100%,0 100%); }
.mountain-far { bottom:28%; height:36%; opacity:.35; transform:scaleX(1.2); filter:blur(3rpx); background-color:rgba(218,212,188,.12); }
.mountain-mid { left:-28%; bottom:17%; height:38%; opacity:.63; transform:scaleX(-1); }
.mountain-near { bottom:4%; height:34%; opacity:.92; background:linear-gradient(180deg,rgba(24,37,38,.32),rgba(12,22,24,.9)); clip-path:polygon(0 52%,13% 34%,24% 63%,39% 15%,55% 53%,69% 27%,83% 60%,100% 37%,100% 100%,0 100%); }
.home-mist { display:none; position:absolute; height:100rpx; width:85%; border-radius:50%; filter:blur(28rpx); background:rgba(229,225,205,.36); }
.mist-left { left:-30%; bottom:29%; transform:rotate(-9deg); }.mist-right { right:-36%; bottom:42%; opacity:.65; transform:rotate(8deg); }
.home-ground { position:absolute; inset:auto 0 0; height:24%; background:linear-gradient(180deg,transparent,rgba(11,20,21,.8)); }
.home-seal { position:absolute; right:9%; top:44%; writing-mode:vertical-rl; color:rgba(99,43,32,.2); border:3rpx solid rgba(117,54,42,.19); padding:10rpx 7rpx; font-size:25rpx; letter-spacing:5rpx; }
.home-top,.home-title-wrap,.home-menu { position:relative; z-index:1; }
.home-top { display:flex; justify-content:space-between; align-items:center; }
.home-mark { font-size:21rpx; color:#9cabb2; letter-spacing:4rpx; }
.home-title-wrap { margin:0 -18rpx -20rpx; padding:28rpx 18rpx 24rpx; border:1rpx solid rgba(232,219,185,.12); border-radius:8rpx; background:linear-gradient(180deg,rgba(13,22,25,.12),rgba(13,22,25,.48) 24%,rgba(13,22,25,.56) 78%,rgba(13,22,25,.08)); box-shadow:0 0 36rpx rgba(10,17,19,.16); display:flex; flex-direction:column; align-items:center; text-align:center; text-shadow:0 2rpx 8rpx rgba(4,9,11,.92),0 0 20rpx rgba(4,9,11,.58); }
.home-eyebrow { color:#b4c4c1; font-size:23rpx; letter-spacing:8rpx; }
.home-title { margin-top:24rpx; color:#f2d796; font-size:82rpx; line-height:1.25; letter-spacing:14rpx; font-weight:800; text-shadow:0 4rpx 32rpx rgba(226,184,102,.38); }
.home-subtitle { margin-top:10rpx; font-size:24rpx; color:#c0b99e; letter-spacing:6rpx; }
.title-rule { width:210rpx; height:2rpx; margin:34rpx 0 27rpx; background:linear-gradient(90deg,transparent,#b79b62,transparent); }
.title-rule view { width:8rpx; height:8rpx; margin:-3rpx auto; transform:rotate(45deg); background:#e5ca8a; }
.home-story { max-width:560rpx; white-space:pre-line; font-size:24rpx; line-height:1.9; color:#f0eee3; text-shadow:0 1rpx 5rpx rgba(0,0,0,.95); }
.home-menu { width:100%; margin:0 -18rpx -24rpx; padding:24rpx 18rpx 18rpx; box-sizing:border-box; border:1rpx solid rgba(232,219,185,.14); border-bottom:0; border-radius:10rpx 10rpx 0 0; background:linear-gradient(180deg,rgba(12,20,22,.25),rgba(10,17,19,.68)); box-shadow:0 -10rpx 36rpx rgba(8,14,15,.2); display:flex; flex-direction:column; align-items:center; }
.start-button { width:100%; height:94rpx; display:flex; align-items:center; justify-content:center; gap:30rpx; border:1rpx solid #ddc17c; border-radius:8rpx; color:#1b2329; background:linear-gradient(100deg,#d7bb78,#f0d99e 50%,#c8a965); box-shadow:0 8rpx 28rpx rgba(203,169,96,.22); font-size:31rpx; font-weight:700; letter-spacing:8rpx; }
.start-arrow { font-size:42rpx; font-weight:400; }
.menu-button { margin-top:20rpx; width:100%; height:78rpx; border:1rpx solid rgba(225,215,188,.48); border-radius:8rpx; color:#f0ebdb; background:rgba(19,27,28,.76); box-shadow:inset 0 1rpx rgba(255,255,255,.08),0 4rpx 16rpx rgba(0,0,0,.22); font-size:27rpx; letter-spacing:5rpx; text-shadow:0 1rpx 5rpx rgba(0,0,0,.8); }
.home-version { margin-top:29rpx; font-size:19rpx; color:#d0c9b1; letter-spacing:4rpx; }
.settings-shade { position:absolute; inset:0; z-index:5; display:flex; align-items:center; justify-content:center; padding:36rpx; box-sizing:border-box; background:rgba(4,8,12,.78); }
.settings-card { width:100%; padding:36rpx 30rpx 28rpx; border:1rpx solid rgba(220,190,126,.42); border-radius:18rpx; background:linear-gradient(145deg,#293642,#151e27); box-shadow:0 20rpx 70rpx rgba(0,0,0,.5); }
.settings-title { display:block; margin-bottom:28rpx; text-align:center; color:#efd494; font-size:34rpx; letter-spacing:6rpx; }
.setting-row { display:flex; align-items:center; justify-content:space-between; padding:21rpx 8rpx; border-bottom:1rpx solid rgba(202,207,194,.1); color:#d7d9d1; font-size:27rpx; }
.settings-done { margin-top:30rpx; width:100%; color:#21272b; background:#d7bd7c; font-size:27rpx; }
.intro-shade { position:absolute; inset:0; z-index:7; display:flex; align-items:center; justify-content:center; padding:32rpx; box-sizing:border-box; background:rgba(4,8,12,.86); }
.intro-card { width:100%; max-height:88vh; display:flex; flex-direction:column; padding:38rpx 30rpx 26rpx; box-sizing:border-box; border:1rpx solid rgba(220,190,126,.46); border-radius:18rpx; background:linear-gradient(145deg,#293642,#151e27); box-shadow:0 20rpx 70rpx rgba(0,0,0,.55); }
.intro-kicker { color:#a8b7b6; font-size:21rpx; letter-spacing:5rpx; text-align:center; }
.intro-title { margin:14rpx 0 22rpx; color:#efd494; font-size:36rpx; letter-spacing:5rpx; text-align:center; }
.intro-scroll { min-height:0; max-height:55vh; }
.intro-paragraph { display:block; margin:0 2rpx 20rpx; color:#c2cbc8; font-size:24rpx; line-height:1.9; text-align:justify; }
.intro-enter { flex:none; margin-top:14rpx; width:100%; color:#20272b; background:linear-gradient(100deg,#d7bb78,#f0d99e 50%,#c8a965); font-size:28rpx; letter-spacing:5rpx; }
.intro-back { flex:none; margin-top:12rpx; width:100%; border:1rpx solid rgba(205,195,166,.25); color:#c7c9c2; background:transparent; font-size:24rpx; }
/* 首页开场动效：标题从画面外落入，菜单随后出现 */
.home-screen { isolation:isolate; }
.home-sun { animation: sun-breathe 8s ease-in-out infinite alternate; }
.home-mist { animation: mist-drift 16s ease-in-out infinite alternate; }
.mist-right { animation-delay:-8s; }
.home-title-wrap { animation: content-rise .9s .5s both cubic-bezier(.2,.8,.2,1); }
.home-eyebrow { animation: eyebrow-in .7s .35s both ease-out; }
.home-title { animation: title-enter 1.35s .15s both cubic-bezier(.16,1,.3,1); }
.home-subtitle,.title-rule,.home-story { animation: content-rise .75s .85s both ease-out; }
.home-menu { animation: menu-enter .9s 1.05s both cubic-bezier(.16,1,.3,1); }
.home-mark { animation: fade-in .7s .65s both ease-out; }
.start-button { transition:transform .18s ease,filter .18s ease,box-shadow .18s ease; }
.start-button:active { transform:scale(.975); filter:brightness(1.08); box-shadow:0 2rpx 12rpx rgba(203,169,96,.15); }
.menu-button:active { background:rgba(205,190,150,.15); }
@keyframes title-enter { 0% { opacity:0; transform:translateY(-110vh) scale(.78); letter-spacing:30rpx; filter:blur(12rpx); } 68% { opacity:1; transform:translateY(12rpx) scale(1.03); filter:blur(0); } 84% { transform:translateY(-5rpx) scale(.995); } 100% { opacity:1; transform:translateY(0) scale(1); letter-spacing:14rpx; filter:blur(0); } }
@keyframes content-rise { from { opacity:0; transform:translateY(28rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes menu-enter { from { opacity:0; transform:translateY(70rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes eyebrow-in { from { opacity:0; transform:translateY(-22rpx); letter-spacing:16rpx; } to { opacity:1; transform:translateY(0); letter-spacing:8rpx; } }
@keyframes fade-in { from { opacity:0; } to { opacity:1; } }
@keyframes orbit-breathe { from { opacity:.7; transform:translate(-50%,-50%) scale(.96); } to { opacity:1; transform:translate(-50%,-50%) scale(1.04); } }
@keyframes orbit-turn { from { transform:translate(-50%,-50%) rotate(0); } to { transform:translate(-50%,-50%) rotate(360deg); } }
@keyframes sun-breathe { from { opacity:.56; transform:translate(-50%,-50%) scale(.96); } to { opacity:.82; transform:translate(-50%,-50%) scale(1.04); } }
@keyframes mist-drift { from { translate:-4% 0; opacity:.38; } to { translate:5% -8rpx; opacity:.72; } }

/* Combat art direction: ink silhouettes, talisman rings, and elemental arenas */
.arena { background:radial-gradient(ellipse at 50% 58%,rgba(80,102,102,.32),rgba(12,18,26,.88) 70%),linear-gradient(180deg,#17232c,#10171f); }
.arena:before { content:""; position:absolute; inset:0; opacity:.5; background:repeating-linear-gradient(168deg,transparent 0 44rpx,rgba(201,190,158,.025) 46rpx 48rpx,transparent 50rpx 92rpx); pointer-events:none; }
.arena:after { inset:12% 10% 14%; border:1rpx solid rgba(210,188,133,.12); box-shadow:0 0 0 22rpx rgba(210,188,133,.025),inset 0 0 50rpx rgba(210,188,133,.025); }
.arena.stage-1 { background:radial-gradient(ellipse at 50% 66%,rgba(85,139,107,.4),rgba(20,44,46,.72) 46%,#101a22 82%); }
.arena.stage-2 { background:radial-gradient(ellipse at 50% 68%,rgba(148,91,70,.38),rgba(50,35,39,.78) 48%,#111820 83%); }
.arena.stage-3 { background:radial-gradient(ellipse at 50% 72%,rgba(186,86,48,.45),rgba(66,34,32,.78) 47%,#171820 83%); }
.arena.stage-4 { background:radial-gradient(ellipse at 50% 62%,rgba(67,123,148,.4),rgba(29,49,64,.8) 48%,#101720 84%); }
.arena.stage-5 { background:radial-gradient(ellipse at 50% 52%,rgba(133,104,160,.35),rgba(40,34,62,.8) 49%,#11151f 85%); }
.scene-haze { position:absolute; width:62%; height:90rpx; border-radius:50%; background:rgba(186,207,194,.07); filter:blur(22rpx); transform:rotate(-14deg); pointer-events:none; }
.haze-one { left:-14%; top:35%; }.haze-two { right:-20%; top:65%; transform:rotate(12deg); }
.scene-ridge { position:absolute; bottom:12%; width:58%; height:24%; opacity:.24; background:linear-gradient(145deg,transparent 0 28%,rgba(11,18,25,.75) 29% 58%,transparent 59%),linear-gradient(35deg,transparent 0 35%,rgba(16,26,31,.8) 36% 69%,transparent 70%); pointer-events:none; }
.ridge-left { left:-15%; }.ridge-right { right:-18%; transform:scaleX(-1) scaleY(.78); bottom:16%; }
.scene-sigil { position:absolute; left:50%; top:51%; transform:translate(-50%,-50%); color:rgba(224,207,161,.045); font-size:116rpx; font-weight:800; letter-spacing:12rpx; white-space:nowrap; pointer-events:none; }
.player { width:82rpx; height:82rpx; background:transparent; box-shadow:none; transition:left .14s linear,top .14s linear; }
.player-core { position:absolute; z-index:2; width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #f2d99a; border-radius:50%; color:#fff1c2; background:radial-gradient(circle at 40% 35%,#fff3c9 0,#d6b96b 25%,#866d42 62%,#292b2b 100%); box-shadow:0 0 20rpx rgba(250,218,143,.65),inset 0 0 12rpx rgba(255,248,218,.7); font-size:30rpx; font-weight:800; }
.player-orbit { position:absolute; inset:-2rpx; border:1rpx solid rgba(245,215,149,.78); border-radius:50%; box-shadow:0 0 18rpx rgba(244,208,126,.28); animation:orbit-turn 7s linear infinite; }
.player-spark { position:absolute; z-index:3; width:8rpx; height:8rpx; border-radius:50%; background:#fff0bd; box-shadow:0 0 12rpx 4rpx rgba(248,208,116,.8); }
.spark-a { left:7rpx; top:14rpx; }.spark-b { right:0; top:38rpx; }.spark-c { left:23rpx; bottom:-1rpx; }
.enemy { min-width:54rpx; min-height:64rpx; filter:none; transition:left .14s linear,top .14s linear; }
.creature { position:relative; width:52rpx; height:52rpx; margin:0 auto 5rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid rgba(180,209,186,.68); border-radius:42% 58% 48% 52%; background:radial-gradient(circle at 48% 36%,#90ac95 0,#415e5a 27%,#1d3037 68%,#10181f 100%); box-shadow:0 0 16rpx rgba(112,172,147,.36),inset 0 -10rpx 12rpx rgba(5,13,18,.65); transform:rotate(45deg); }
.creature-core { color:#d9e6cd; font-size:25rpx; font-weight:800; text-shadow:0 0 9rpx #b3d1b3; transform:rotate(-45deg); }
.creature-eye { position:absolute; top:17rpx; width:5rpx; height:5rpx; border-radius:50%; background:#f4d58b; box-shadow:0 0 7rpx 2rpx rgba(242,185,96,.8); }
.eye-left { left:11rpx; }.eye-right { right:11rpx; }
.creature-aura { position:absolute; inset:-8rpx; border:1rpx solid rgba(160,194,171,.25); border-radius:50%; transform:rotate(-45deg) scaleY(.74); }
.enemy-hp { position:relative; z-index:2; width:50rpx; height:6rpx; background:rgba(18,13,17,.8); border:1rpx solid rgba(216,194,151,.28); box-sizing:border-box; }
.enemy-hp view { background:linear-gradient(90deg,#b44f43,#e99c61); }
.boss .creature { width:118rpx; height:118rpx; margin-bottom:9rpx; border-width:3rpx; border-radius:40% 60% 44% 56%; background:radial-gradient(circle at 48% 38%,var(--boss-light),var(--boss-mid) 32%,#17202b 74%,#0b1118); border-color:var(--boss-light); box-shadow:0 0 34rpx var(--boss-glow),inset 0 0 28rpx rgba(238,218,171,.2); animation:boss-float 2.4s ease-in-out infinite; }
.boss .creature-core { font-size:54rpx; color:#fff0cb; text-shadow:0 0 17rpx var(--boss-glow); }
.boss .creature-eye { top:37rpx; width:9rpx; height:9rpx; background:#fff0bd; box-shadow:0 0 12rpx 4rpx var(--boss-glow); }
.boss .eye-left { left:25rpx; }.boss .eye-right { right:25rpx; }
.boss .creature-aura { inset:-20rpx; border:2rpx solid var(--boss-glow); opacity:.5; animation:aura-pulse 2s ease-in-out infinite; }
.boss .enemy-hp { width:120rpx; height:9rpx; margin:0 auto; }
.boss-1 { --boss-light:#a9d2a1; --boss-mid:#356d58; --boss-glow:rgba(115,208,143,.8); }
.boss-2 { --boss-light:#f0c17b; --boss-mid:#9d533f; --boss-glow:rgba(233,133,87,.8); }
.boss-3 { --boss-light:#ffd08a; --boss-mid:#c34232; --boss-glow:rgba(255,112,63,.9); }
.boss-4 { --boss-light:#a4d5e4; --boss-mid:#3b718e; --boss-glow:rgba(111,205,235,.85); }
.boss-5 { --boss-light:#d3b4ed; --boss-mid:#685590; --boss-glow:rgba(180,132,232,.9); }
.effect { color:#ffe5a4; font-weight:800; text-shadow:0 0 12rpx #edb75e; }
@keyframes boss-float { 0%,100% { transform:rotate(45deg) translateY(0); } 50% { transform:rotate(45deg) translateY(-7rpx); } }
@keyframes aura-pulse { 0%,100% { transform:rotate(-45deg) scale(.9); opacity:.25; } 50% { transform:rotate(-45deg) scale(1.08); opacity:.75; } }
/* 盘古神念：远古巨人剪影与开天斧 */
.player { width:120rpx; height:156rpx; }
.player-hurt { animation:player-hurt .28s ease-out; filter:brightness(1.8) sepia(.7) saturate(4); }
@keyframes player-hurt { 0%,100% { opacity:1; } 35% { opacity:.3; } 70% { opacity:1; } }
.pangu-sprite { position:absolute; z-index:2; left:50%; top:50%; width:190rpx; height:230rpx; transform:translate(-50%,-50%); filter:drop-shadow(0 0 8rpx rgba(18,20,18,.72)); pointer-events:none; }
.player-orbit { inset:12rpx -12rpx; border-color:rgba(247,215,145,.48); transform:rotate(-24deg); animation:giant-aura 5s ease-in-out infinite alternate; }
.pangu-silhouette { position:absolute; z-index:2; left:50%; bottom:14rpx; width:82rpx; height:126rpx; transform:translateX(-50%); filter:drop-shadow(0 0 12rpx rgba(236,190,105,.55)); }
.pangu-head { position:absolute; z-index:4; left:28rpx; top:7rpx; width:28rpx; height:32rpx; border-radius:48% 48% 42% 42%; background:linear-gradient(100deg,#5a4935,#e3c78d 43%,#8c7148 78%,#3b3530); box-shadow:inset 0 0 0 1rpx rgba(255,230,170,.55); }
.pangu-head:before { content:""; position:absolute; left:2rpx; top:-5rpx; width:26rpx; height:12rpx; border-radius:60% 45% 25% 30%; background:linear-gradient(90deg,#20242a,#aa8b57,#35312b); }
.pangu-hair { position:absolute; z-index:1; left:17rpx; top:4rpx; width:48rpx; height:48rpx; border-radius:55% 55% 34% 34%; background:linear-gradient(90deg,#27272a 0,#79674d 30%,#c5a96e 50%,#463d34 78%,#202329 100%); clip-path:polygon(14% 8%,80% 0,100% 42%,86% 100%,72% 58%,62% 94%,49% 59%,37% 100%,28% 57%,7% 88%,14% 48%,0 30%); }
.pangu-brow { position:absolute; left:4rpx; right:4rpx; top:12rpx; height:4rpx; background:#322b25; border-radius:50%; }
.pangu-brow:after { content:""; position:absolute; left:4rpx; top:6rpx; width:4rpx; height:3rpx; border-radius:50%; background:#ffe6a1; box-shadow:12rpx 0 0 #ffe6a1,0 0 7rpx 2rpx #e9bd68; }
.pangu-beard { position:absolute; left:8rpx; top:19rpx; width:13rpx; height:18rpx; border-radius:30% 30% 60% 60%; background:linear-gradient(90deg,#262529,#b79a62 55%,#38312a); clip-path:polygon(0 0,100% 0,84% 72%,50% 100%,16% 72%); }
.pangu-body { position:absolute; z-index:3; left:11rpx; top:37rpx; width:61rpx; height:54rpx; clip-path:polygon(29% 0,71% 0,100% 18%,87% 100%,13% 100%,0 18%); background:linear-gradient(90deg,#333238,#b29561 24%,#e0c582 47%,#806846 75%,#292a2e); }
.pangu-neck { position:absolute; left:24rpx; top:-3rpx; width:14rpx; height:12rpx; background:#bea06a; }
.pangu-chest { position:absolute; left:7rpx; right:7rpx; top:10rpx; height:30rpx; clip-path:polygon(0 0,50% 24%,100% 0,77% 100%,50% 75%,23% 100%); background:linear-gradient(100deg,#776142,#e5ca8a 50%,#66543b); }
.pangu-belt { position:absolute; left:4rpx; right:4rpx; bottom:5rpx; height:7rpx; background:#312c29; border-top:2rpx solid #dbbd79; }
.pangu-arm { position:absolute; z-index:2; top:41rpx; width:17rpx; height:49rpx; border-radius:8rpx; background:linear-gradient(90deg,#484039,#d2b67c 55%,#62513b); transform-origin:top center; }
.arm-left { left:9rpx; transform:rotate(13deg); }.arm-right { right:6rpx; height:58rpx; transform:rotate(-18deg); }
.pangu-leg { position:absolute; z-index:2; top:82rpx; width:21rpx; height:37rpx; clip-path:polygon(13% 0,87% 0,100% 100%,0 100%); background:linear-gradient(90deg,#37363a,#c3a76d 48%,#514536); }
.leg-left { left:21rpx; transform:rotate(5deg); }.leg-right { right:19rpx; transform:rotate(-6deg); }
.pangu-axe { position:absolute; z-index:5; right:-5rpx; top:17rpx; width:31rpx; height:70rpx; transform:rotate(14deg); }
.axe-handle { position:absolute; left:12rpx; top:5rpx; width:5rpx; height:64rpx; border-radius:3rpx; background:linear-gradient(90deg,#4d3828,#d9bb77,#62472c); box-shadow:0 0 5rpx rgba(239,201,124,.5); }
.axe-blade { position:absolute; left:0; top:0; width:25rpx; height:30rpx; clip-path:polygon(55% 0,100% 10%,86% 75%,52% 100%,42% 61%,0 48%,28% 18%); background:linear-gradient(120deg,#fff1bb,#d6ba78 50%,#736149); box-shadow:0 0 9rpx #f1d18a; }
@keyframes giant-aura { from { opacity:.55; transform:rotate(-30deg) scale(.96); } to { opacity:1; transform:rotate(20deg) scale(1.05); } }

/* 本地水墨矿彩资源：场景低对比，战斗轮廓高对比。 */
.arena-art,.arena-vignette { position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; }
.arena-art { opacity:.8; }
.arena-vignette { background:radial-gradient(ellipse at 50% 48%,rgba(8,16,21,.08) 15%,rgba(8,16,21,.48) 100%),linear-gradient(180deg,rgba(7,14,20,.7),transparent 22%,transparent 74%,rgba(7,14,20,.7)); }
.arena-title { top:62rpx; color:#f2dfb5; font-size:25rpx; text-shadow:0 2rpx 8rpx #080e15; letter-spacing:6rpx; }
.weapon-badge { left:50%; top:18rpx; transform:translateX(-50%); white-space:nowrap; border-color:rgba(219,190,124,.35); background:rgba(11,20,26,.8); }
.hint { color:#d0d4c4; text-shadow:0 2rpx 5rpx #080e15; font-size:19rpx; }
.scene-sigil { display:none; }
.creature-art-wrap { width:78rpx; height:78rpx; margin:0 auto; }
.creature-art { width:100%; height:100%; filter:drop-shadow(0 3rpx 4rpx rgba(0,0,0,.8)); }
.enemy { width:78rpx; min-height:78rpx; }
.enemy.boss { width:160rpx; min-height:160rpx; animation:none; }
.boss .creature-art-wrap { width:160rpx; height:160rpx; animation:guardian-breathe 3s ease-in-out infinite; }
.boss .creature-art { filter:drop-shadow(0 0 8rpx var(--boss-glow)); }
.enemy-hp { margin-top:-5rpx; }
.boss .enemy-hp { width:100rpx; height:7rpx; }
.pangu-sprite { width:116rpx; height:146rpx; }
.player { width:84rpx; height:104rpx; }
.player-orbit { inset:15rpx -10rpx; }
.choice-panel { border-radius:8rpx; padding:34rpx 24rpx; border-color:rgba(221,190,121,.55); background:linear-gradient(145deg,#21363a,#101b26); box-shadow:inset 0 0 0 7rpx rgba(207,178,115,.045),0 18rpx 60rpx rgba(0,0,0,.6); }
.choice-title { font-family:"Songti SC","SimSun",serif; letter-spacing:4rpx; font-weight:500; }
.choice { border-radius:6rpx; padding:20rpx 14rpx; background:linear-gradient(90deg,rgba(214,188,124,.1),rgba(214,188,124,.025)); }
.choice:active { background:rgba(214,188,124,.2); border-color:#d6bc7c; }
.choice-icon-art { flex:none; width:76rpx; height:76rpx; }
.choice-name { letter-spacing:3rpx; }
.choice-desc { font-size:20rpx; line-height:1.6; }
.ending { position:relative; overflow:hidden; padding:180rpx 32rpx 44rpx; }
.ending-art,.ending-shade { position:absolute; inset:0; width:100%; height:100%; }
.ending-shade { background:linear-gradient(180deg,rgba(9,16,22,.05),rgba(9,16,22,.65) 30%,#101b26 68%); }
.ending .choice-title,.ending-copy,.ending .restart,.ending-kicker { position:relative; z-index:1; }
.ending-kicker { display:block; color:#d4b97c; font-size:19rpx; letter-spacing:6rpx; margin-bottom:20rpx; }
.ending .choice-title { font-size:48rpx; letter-spacing:10rpx; }
.ending-copy { font-size:24rpx; color:#e2ded0; }
.ending-loss .ending-art { opacity:.6; }
.effect { width:70rpx; height:70rpx; animation:hit .65s ease-out forwards; }
.hit-ring { position:absolute; inset:0; border:3rpx solid #edcf8c; border-radius:50%; box-shadow:0 0 12rpx #dab375,inset 0 0 10rpx #dab375; }
.hit-flare { position:absolute; left:31rpx; top:-12rpx; width:5rpx; height:94rpx; transform:rotate(36deg); background:linear-gradient(transparent,#fff1c9,transparent); }
.effect-fire .hit-ring { border-color:#ef8b53; box-shadow:0 0 18rpx #e36b3e,inset 0 0 12rpx #e36b3e; }
.effect-fire .hit-flare { background:linear-gradient(transparent,#ffc186,transparent); }
.hp-stat { color:#edba9d; }
.bottom { background:transparent; padding-bottom:env(safe-area-inset-bottom); }
.dash,.restart { border-radius:5rpx; background:linear-gradient(135deg,#344443,#1b2b32); letter-spacing:3rpx; }
.toast { top:108rpx; border:1rpx solid rgba(221,190,121,.3); border-radius:4rpx; }
@keyframes guardian-breathe { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-5rpx); } }
@media (prefers-reduced-motion:reduce) { .home-title-wrap,.home-eyebrow,.home-title,.home-subtitle,.title-rule,.home-story,.home-menu,.home-mark,.boss .creature-art-wrap,.player-orbit { animation:none; } }
