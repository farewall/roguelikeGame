.build-weapon { color:#f0d597; font-size:13px; }
.build-stats { font-size:10px; color:#a8bab7; }
.combo-label { color:#b5d8ce; font-size:11px; }
.arena .arena-title { left:12px; top:12px; font-size:12px; }
.arena .hint { bottom:8px; left:100px; right:180px; font-size:10px; opacity:.8; }
.arena .toast { top:60px; z-index:9; font-size:12px; pointer-events:none; }
.attack-range { z-index:1; opacity:.6; }
.range-banner { border-style:dashed; }
.arena-art { opacity:.72; }
.arena-vignette { pointer-events:none; }
.enemy { z-index:4; transition:none; }
.player { z-index:6; }
.enemy-shadow { position:absolute; bottom:6px; left:15%; width:70%; height:12px; background:rgba(0,0,0,.38); border-radius:50%; filter:blur(3px); }
.enemy-role { display:block; text-align:center; font-size:9px; letter-spacing:1px; line-height:1.3; color:#c0d8db; text-shadow:0 1px 3px #000; }
.enemy-ranged .creature-art-wrap { transform:scale(.85); background:radial-gradient(ellipse,rgba(121,164,237,.25),transparent 70%); }
.enemy-ranged .creature-art { filter:hue-rotate(75deg) drop-shadow(0 0 4px #6b94c5); }
.enemy-charger .creature-art-wrap { transform:scale(1.12,.8) rotate(-12deg); }
.enemy-charger .creature-art { filter:hue-rotate(255deg) saturate(.7); }
.enemy-charger .enemy-role { color:#e9bf9f; }
.enemy-elite .creature-art-wrap { transform:scale(1.25); }
.enemy-elite .creature-art { filter:hue-rotate(145deg) drop-shadow(0 0 5px #bc8ce4); }
.enemy-elite .enemy-role { color:#ddbaed; }
.enemy-elite .enemy-hp { background:#4c345f; height:4px; }
.cast-aura { display:none; position:absolute; inset:10%; border:2px dashed #f4ca8a; border-radius:50%; box-shadow:0 0 10px rgba(230,160,96,.4); pointer-events:none; }
.enemy-casting .cast-aura { display:block; animation:cast-pulse .5s ease-in-out infinite alternate; }
.enemy-casting .creature-art-wrap { animation:cast-rise .6s ease-in-out infinite alternate; }
.enemy-recovering .creature-art { opacity:.78; }
.enemy-hit .creature-art { filter:brightness(2.1) drop-shadow(0 0 6px #fff0c3); }
.enemy-burning:before { content:""; position:absolute; left:20%; bottom:8%; width:60%; height:55%; border-radius:50% 50% 20% 20%; background:linear-gradient(0deg,rgba(243,104,50,.55),transparent); pointer-events:none; }
.enemy-slowed:after { content:""; position:absolute; left:10%; bottom:8%; width:80%; height:22%; border:1px solid #9ad9eb; border-radius:50%; box-shadow:0 0 6px #62abc9; pointer-events:none; }
.enemy-shielded .cast-aura { border-style:solid; border-color:#9ad9eb; box-shadow:0 0 12px #5fa6be,inset 0 0 12px #5fa6be; }
.hazard { position:absolute; z-index:2; box-sizing:border-box; pointer-events:none; display:flex; align-items:center; justify-content:center; --danger:#f1bd7a; color:var(--danger); }
.hazard-circle,.hazard-ring { border-radius:50%; }
.hazard-line { border-radius:999px; }
.hazard-warning { border-style:dashed; border-color:var(--danger); background:repeating-linear-gradient(135deg,rgba(239,172,99,.08) 0 5px,rgba(239,172,99,.22) 5px 8px); box-shadow:0 0 0 1px rgba(8,15,19,.7); }
.hazard-active { border-style:solid; border-color:var(--danger); background:repeating-linear-gradient(45deg,rgba(231,109,57,.24) 0 4px,rgba(231,109,57,.48) 4px 8px); box-shadow:0 0 10px rgba(243,157,86,.55),inset 0 0 10px rgba(243,157,86,.4); }
.hazard-ring { background:transparent; }
.hazard-warning.hazard-ring { border-style:dashed; border-color:rgba(241,189,122,.4); outline:1px solid #f1bd7a; box-shadow:0 0 0 1px #192125; }
.hazard-active.hazard-ring { border-color:rgba(123,188,210,.55); }
.hazard-root { --danger:#b9d68b; }
.hazard-root.hazard-active { background:repeating-linear-gradient(65deg,rgba(77,126,79,.35) 0 4px,rgba(169,205,118,.48) 4px 7px); }
.hazard-root.hazard-ring { background:transparent; }
.hazard-flame { --danger:#ffc08c; }
.hazard-flame.hazard-active { background:radial-gradient(circle,rgba(247,166,82,.6),rgba(199,71,41,.45)); }
.hazard-tide { --danger:#abe5f5; }
.hazard-tide.hazard-active { background:repeating-linear-gradient(0deg,rgba(104,181,208,.4) 0 3px,rgba(91,147,182,.15) 3px 8px); }
.hazard-tide.hazard-ring { background:transparent; }
.hazard-order,.hazard-arcane { --danger:#e4c0ef; }
.hazard-order.hazard-active,.hazard-arcane.hazard-active { background:repeating-linear-gradient(90deg,rgba(171,132,197,.3) 0 6px,rgba(223,190,234,.45) 6px 9px); }
.hazard-mark { font-size:14px; line-height:1; font-family:"Songti SC","SimSun",serif; text-shadow:0 1px 4px #000; }
.hazard-ring .hazard-mark { position:absolute; top:-12px; background:#16242a; border-radius:4px; padding:2px 4px; }
.hazard-friendly { z-index:1; border:1px dotted #90c7b7; opacity:.65; box-shadow:none; }
.hazard-friendly.hazard-lava { background:repeating-linear-gradient(35deg,rgba(184,84,40,.22) 0 8px,rgba(229,152,70,.25) 8px 10px); }
.hazard-friendly.hazard-mud { background:radial-gradient(ellipse,rgba(94,153,129,.4),rgba(89,130,107,.12)); }
.hazard-friendly .hazard-mark { color:#abd0bd; font-size:11px; }
.combat-effect { position:absolute; z-index:5; pointer-events:none; }
.fx-shape { position:absolute; inset:0; animation:impact-fade .5s ease-out forwards; }
.fx-bell .fx-shape { border:2px solid #f6dc9c; border-radius:50%; box-shadow:0 0 10px #d6b878,inset 0 0 8px rgba(243,207,131,.3); animation:wave-expand .5s ease-out forwards; }
.fx-blade .fx-shape { border-radius:50%; background:conic-gradient(from 30deg,rgba(235,216,173,.2),rgba(242,227,193,.7) 60deg,rgba(235,216,173,.2) 120deg,transparent 120deg); animation:impact-fade .35s ease-out forwards; }
.fx-impact .fx-shape { background:radial-gradient(circle,#fff7d5,rgba(238,199,121,.35) 30%,transparent 65%); }
.fx-impact .fx-shape:after { content:""; position:absolute; left:48%; top:0; width:4%; height:100%; transform:rotate(35deg); background:#fff3c5; }
.fx-earth .fx-shape { border:3px solid #c7a572; clip-path:polygon(30% 0,70% 0,100% 30%,100% 70%,70% 100%,30% 100%,0 70%,0 30%); background:repeating-conic-gradient(rgba(202,167,100,.35) 0deg 4deg,transparent 4deg 45deg); }
.fx-steam .fx-shape { border-radius:50%; background:radial-gradient(ellipse,rgba(227,247,249,.75),rgba(163,209,215,.2) 50%,transparent 72%); animation:wave-expand .5s ease-out forwards; }
.fx-dissolve .fx-shape { border-radius:50%; background:radial-gradient(ellipse,rgba(202,187,152,.6),transparent 65%); animation:dissolve-out .7s ease-out forwards; }
.world-paused view,.world-paused image,.world-paused text { animation-play-state:paused !important; }
