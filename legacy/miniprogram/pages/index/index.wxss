.memory-art:after,.ending-picture:after { content:""; position:absolute; inset:0; background:linear-gradient(0deg,rgba(12,25,29,.8),transparent 70%); }
.memory-art > text,.ending-picture > text { position:absolute; z-index:1; bottom:22px; left:20px; font-size:23px; color:#e7d19a; writing-mode:vertical-rl; letter-spacing:8px; font-family:"Songti SC","SimSun",serif; }
.memory-content,.ending-content { padding:22px; min-width:0; display:flex; flex-direction:column; }
.story-kicker { display:block; font-size:10px; letter-spacing:2px; color:#a9c1b4; }
.story-title { display:block; font-family:"Songti SC","SimSun",serif; font-size:25px; letter-spacing:3px; color:#eddbac; margin:9px 0 12px; }
.story-copy { display:block; font-size:13px; line-height:1.9; color:#ced3c6; }
.memory-scroll { max-height:33vh; min-height:0; }
.story-note { display:block; color:#91a99f; font-size:10px; line-height:1.6; margin:12px 0; }
.story-primary,.story-secondary { border-radius:4px; font-size:13px; line-height:2.6; margin:0; padding:0 14px; }
.story-primary { color:#202b2a; background:linear-gradient(120deg,#c7ac70,#ebd59d); }
.story-secondary { color:#d3cbb6; border:1px solid #7c806b; background:transparent; }
.ending-text { font-size:12px; }
.run-facts { display:flex; justify-content:space-between; gap:8px; margin:12px 0 8px; padding:10px 0; border-top:1px solid #6e745b; border-bottom:1px solid #6e745b; font-size:11px; color:#e7d29e; }
.run-build { font-size:11px; line-height:1.7; color:#b4c8bc; }
.ending-actions { display:flex; gap:10px; margin-top:14px; }
.ending-actions button { flex:1; }
.archive-panel { width:94%; max-width:730px; max-height:calc(100vh - 32px); padding:20px 24px 14px; box-sizing:border-box; border:1px solid #7d7857; background:linear-gradient(120deg,#203337,#15232b); border-radius:6px; }
.archive-heading { display:flex; justify-content:space-between; align-items:center; }
.archive-heading .story-title { font-size:22px; margin:4px 0 10px; }
.archive-close { margin:0; font-size:12px; color:#d9c798; background:transparent; border:1px solid #6d7562; border-radius:4px; line-height:2.3; padding:0 16px; }
.archive-tabs { display:flex; gap:8px; border-bottom:1px solid #667463; padding-bottom:10px; }
.archive-tabs button { margin:0; flex:1; font-size:12px; line-height:2.2; color:#aebfb2; background:transparent; border:1px solid #455d58; border-radius:4px; }
.archive-tabs button.tab-active { color:#efdba7; border-color:#b8a373; background:rgba(204,183,123,.08); }
.archive-scroll { height:43vh; }
.archive-entry { padding:12px 0; border-bottom:1px solid rgba(166,186,162,.2); }
.archive-entry-title { display:block; font-size:14px; color:#e6d19b; }
.archive-entry-caption { display:block; font-size:10px; color:#8fb0a0; margin-top:4px; }
.archive-entry-copy { display:block; margin-top:6px; font-size:12px; color:#c1cabe; line-height:1.8; }
.archive-locked { opacity:.5; }
.archive-empty { display:block; color:#b6c3b6; font-size:12px; line-height:1.8; margin:25px 5px; }
.archive-footnote { display:block; margin-top:10px; font-size:10px; color:#8ca79a; }
@keyframes cast-pulse { from { opacity:.6; transform:scale(.85); } to { opacity:1; transform:scale(1.12); } }
@keyframes cast-rise { from { transform:translateY(0) scale(1); } to { transform:translateY(-3px) scale(1.04); } }
@keyframes wave-expand { 0% { transform:scale(.12); opacity:1; } 65% { opacity:.8; } 100% { transform:scale(1); opacity:0; } }
@keyframes impact-fade { from { opacity:1; } to { opacity:0; } }
@keyframes dissolve-out { from { opacity:.8; transform:scale(.6); } to { opacity:0; transform:translateY(-15px) scale(1.5); } }
@media (max-height:350px) {
  .home-menu { padding:12px; }
  .home-menu .menu-button { margin-top:7px; }
  .home-version { margin-top:8px; }
  .weapon-select { padding:12px 18px; }
  .weapon-select .intro-title { font-size:19px; margin:3px 0 7px; }
  .weapon-select .intro-paragraph { margin-bottom:8px; }
  .weapon-option { padding:8px 12px; }
  .weapon-symbol { width:25px; height:25px; font-size:16px; }
  .weapon-option-desc { font-size:10px; }
  .weapon-option-name { font-size:14px; margin-top:3px; }
  .intro-actions { margin-top:8px; }
  .upgrade-shade .choice-panel { padding:12px 16px; gap:8px; }
  .upgrade-shade .choice { min-height:160px; padding:10px; gap:5px; }
  .health-hud { width:130px; }
  .phase-status { margin-left:8px; }
  .objective { font-size:9px; }
  .memory-content,.ending-content { padding:16px; }
  .story-title { font-size:21px; margin:6px 0 8px; }
  .story-copy { font-size:12px; line-height:1.7; }
  .memory-art,.ending-picture { min-height:215px; }
  .story-note { margin:8px 0; }
  .archive-panel { padding:12px 20px; }
  .archive-scroll { height:40vh; }
}
@media (prefers-reduced-motion:reduce) { .enemy-casting .cast-aura,.enemy-casting .creature-art-wrap { animation:none; } }

/* Second pass: silhouettes first, restrained ground decoration, readable rewards. */
.arena:after { display:none; }
.arena .scene-haze { opacity:.4; }
.arena .boss-hud { width:42%; max-width:350px; }
.boss-caption { align-items:center; font-size:11px; }
.boss-caption text:last-child { white-space:nowrap; }
.arena .hint { z-index:7; color:#d6dfce; text-shadow:0 1px 4px #071318; }
.enemy-ranged .creature-art-wrap { transform:scale(.72,1.08); }
.enemy-ranged .enemy-weapon { position:absolute; right:3px; top:2px; width:3px; height:calc(75 * var(--ui)); border-radius:2px; background:#b2cde0; transform:rotate(-14deg); box-shadow:0 0 3px #5b94c0; }
.enemy-ranged .enemy-weapon:before { content:""; position:absolute; top:-4px; left:-3px; width:9px; height:9px; border:1px solid #c4def2; border-radius:50%; background:#4c7caa; }
.enemy-charger .creature-art-wrap { transform:scale(1.28,.7); }
.enemy-charger .enemy-weapon { position:absolute; right:0; top:22%; width:40%; height:28%; background:#d7a37e; clip-path:polygon(0 30%,100% 0,65% 50%,100% 100%,0 70%); opacity:.9; }
.enemy-elite .enemy-weapon { position:absolute; inset:4%; border:1px solid #c8a9e0; transform:rotate(45deg); box-shadow:0 0 5px #85629b; pointer-events:none; }
.enemy-role { position:absolute; top:-6px; left:50%; transform:translateX(-50%); padding:2px 4px; border-radius:3px; background:rgba(8,18,24,.85); border:1px solid #576e6b; font-size:10px; line-height:1; white-space:nowrap; z-index:3; }
.enemy-frozen .creature-art { filter:brightness(1.4) drop-shadow(0 0 5px #b5ecf2); }
.enemy-frozen .cast-aura { display:block; border:2px solid #a8dfea; animation:none; border-radius:12%; transform:rotate(20deg); background:rgba(159,221,239,.14); }
.enemy-exposed .cast-aura { display:block; border:2px solid #f3dfa6; border-radius:30%; animation:cast-pulse .5s ease-in-out infinite alternate; }
.enemy-exposed .creature-art { filter:brightness(1.15); }
.enemy.boss,.boss .creature-art-wrap { width:calc(190 * var(--ui)); min-height:calc(190 * var(--ui)); height:calc(190 * var(--ui)); }
.enemy.boss-5,.boss-5 .creature-art-wrap { width:calc(205 * var(--ui)); min-height:calc(205 * var(--ui)); height:calc(205 * var(--ui)); }
.pangu-frame { filter:drop-shadow(0 1px 2px #17201b) drop-shadow(0 0 2px rgba(255,231,170,.35)); }
.player-warded .player-orbit { border:2px solid #cee8ce; box-shadow:0 0 12px #a8d7c0,inset 0 0 8px #a8d7c0; }
.build-path { font-size:10px; color:#b6cfb9; }
.hazard-friendly.hazard-confluence { background:repeating-linear-gradient(35deg,rgba(211,142,75,.22) 0 5px,rgba(90,164,141,.3) 5px 10px); border-color:#a9c5a8; }
.fx-blade .fx-shape { background:conic-gradient(from calc(90deg - var(--cone)),rgba(235,216,173,.35) 0deg,rgba(242,227,193,.65) var(--cone),rgba(235,216,173,.25) calc(2 * var(--cone)),transparent calc(2 * var(--cone))); }
.fx-water-pulse .fx-shape { border:2px solid #bce8ed; border-radius:50%; box-shadow:inset 0 0 12px #86b9cd; animation:wave-expand .5s ease-out forwards; }
.fx-ember .fx-shape { border-radius:50%; background:repeating-conic-gradient(rgba(239,146,80,.55) 0deg 4deg,transparent 4deg 30deg); animation:wave-expand .5s ease-out forwards; }
.fx-ward .fx-shape { border:3px double #c5e4c3; border-radius:50%; animation:wave-expand .5s ease-out forwards; }
.memory-panel { height:calc(100vh - 32px); max-height:350px; }
.memory-content { min-height:0; }
.memory-content .story-title { flex:none; }
.memory-content .memory-scroll { flex:1; min-height:24px; max-height:none; }
.memory-rewards { flex:none; padding-top:8px; }
.reward-title { display:block; margin-bottom:6px; font-size:11px; color:#e2ce96; }
.reward-options { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.reward-option { margin:0; padding:7px 9px; text-align:left; white-space:normal; color:#c5d1c6; border:1px solid #5b766b; border-radius:4px; background:rgba(17,36,39,.85); line-height:1.4; }
.reward-option::after { border:none; }
.reward-name { display:block; font-size:12px; color:#e8d5a5; margin-bottom:3px; }
.reward-desc,.reward-change { display:block; font-size:10px; line-height:1.5; }
.reward-change { color:#a8c9b6; margin-top:3px; }
.reward-selected { border-color:#e2ce96; background:rgba(183,163,99,.15); }
.reward-option[disabled] { color:#99a99f; }
.reward-option[disabled]:not(.reward-selected) { opacity:.5; }
.story-primary[disabled] { opacity:.45; color:#5e665b; }
.memory-content .story-note { flex:none; margin:7px 0; }
.memory-content .story-primary { flex:none; }
.run-insight { display:block; margin-top:6px; color:#a8beb1; font-size:10px; line-height:1.6; white-space:pre-line; }
.report-line { display:block; }
.ending-content { overflow-y:auto; }
@media (max-height:350px) {
  .memory-content .story-title { font-size:19px; margin:4px 0 6px; }
  .memory-content { padding:12px 16px; }
  .reward-option { padding:5px 7px; }
  .reward-name { font-size:11px; }
  .reward-desc,.reward-change { font-size:9px; }
  .memory-content .story-note { margin:5px 0; font-size:9px; }
  .ending-content .story-copy { font-size:11px; }
  .ending-actions { margin-top:10px; }
  .arena .hint { left:115px; right:170px; font-size:9px; }
}
