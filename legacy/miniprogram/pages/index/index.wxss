.memory-panel,.ending-panel { display:grid; grid-template-columns:32% minmax(0,1fr); max-width:760px; width:94%; max-height:calc(100vh - 32px); overflow:hidden; border:1px solid rgba(222,196,136,.5); background:#17282d; border-radius:6px; box-shadow:0 16px 50px #0008; }
