/* P0–P2 pass: readable combat silhouettes and landscape information hierarchy. */
.phase-status { display:flex; flex-direction:column; gap:3px; flex:1; min-width:0; margin-left:16px; font-size:12px; color:#d7c293; }
.objective { color:#aebbb4; font-size:10px; white-space:nowrap; }
.health-hud { width:160px; flex:none; }
.health-caption,.boss-caption { display:flex; justify-content:space-between; gap:10px; font-size:11px; color:#e6d2ab; margin-bottom:5px; }
.health-track,.boss-track { height:5px; border:1px solid rgba(212,180,118,.22); background:#182125; border-radius:4px; overflow:hidden; }
.health-fill { height:100%; background:linear-gradient(90deg,#8d5b40,#e8bf79); transition:width .15s; }
.health-low { background:linear-gradient(90deg,#8b3f3c,#e28267); }
.boss-hud { position:absolute; top:8px; left:50%; transform:translateX(-50%); width:34%; max-width:300px; z-index:8; padding:6px 10px; border:1px solid rgba(208,177,116,.3); border-radius:4px; background:rgba(10,19,23,.88); pointer-events:none; }
